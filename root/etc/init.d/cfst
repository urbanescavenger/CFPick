#!/bin/sh /etc/rc.common

# Standalone core-based speed test web console (mihomo / Xray-core).
# It reads its listen address, port and access token from
# /etc/cf-speedtest/config.json, so this service has no UCI settings of its
# own.  Enable it from LuCI: Services -> PassWall Speed Test -> Standalone.

START=97
USE_PROCD=1

PROG=/usr/bin/cfst
PIDFILE=/var/run/cfst.pid

start_service() {
	[ -x "$PROG" ] || return 0
	[ -f /etc/cf-speedtest/config.json ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn 3600 5 5
	procd_set_param pidfile "$PIDFILE"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$PIDFILE"
}
