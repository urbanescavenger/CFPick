#!/bin/sh
# First install: create the standalone engine's JSON config with a LAN
# listen address and a random access token.  Existing configs are kept
# (upgrades must not reset nodes, settings or the token).

[ -f /etc/cf-speedtest/config.json ] && exit 0

mkdir -p /etc/cf-speedtest
chmod 700 /etc/cf-speedtest

CFST_APP_DIR=/usr/lib/cf-speedtest \
CFST_CONFIG_DIR=/etc/cf-speedtest \
CFST_STATE_DIR=/etc/cf-speedtest/state \
CFST_LOG_DIR=/tmp/log/cf-speedtest \
PYTHONPATH=/usr/lib/cf-speedtest \
python3 - <<'PY'
import secrets

from cfspeedtest import config

cfg = config.load()
cfg["web"]["listen"] = "0.0.0.0"
cfg["web"]["port"] = 17545
cfg["web"]["token"] = secrets.token_hex(16)
config.save(cfg)
PY

chmod 600 /etc/cf-speedtest/config.json
exit 0
