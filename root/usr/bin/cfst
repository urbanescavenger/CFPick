#!/bin/sh
# Standalone core-based speed test (mihomo / Xray-core), independent of
# PassWall's run_socks.  The engine lives in /usr/lib/cf-speedtest; its
# configuration, results and optional downloaded cores stay in /etc so they
# survive reboots (OpenWrt's /var is tmpfs).
set -eu

APP_DIR=/usr/lib/cf-speedtest

export CFST_APP_DIR="${CFST_APP_DIR:-$APP_DIR}"
export CFST_CONFIG_DIR="${CFST_CONFIG_DIR:-/etc/cf-speedtest}"
export CFST_STATE_DIR="${CFST_STATE_DIR:-/etc/cf-speedtest/state}"
export CFST_LOG_DIR="${CFST_LOG_DIR:-/tmp/log/cf-speedtest}"
export PYTHONPATH="$CFST_APP_DIR${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m cfspeedtest "$@"
