* text=auto

# These are executed on Linux (Debian/Ubuntu and OpenWrt); CRLF must never
# reach a shebang or a systemd unit.
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.service text eol=lf
*.uc text eol=lf
root/www/cfst/cgi-bin/* text eol=lf
debian/cfst text eol=lf
root/usr/bin/cfst text eol=lf
root/etc/init.d/cfst text eol=lf
root/etc/uci-defaults/95-cfst text eol=lf
